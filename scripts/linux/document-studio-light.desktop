[Desktop Entry]
Type=Application
Name=Document Studio Light
Comment=Create, edit and print documents offline
Exec=/usr/bin/document-studio-light %F
Icon=com.forbiddenfantasy.DocumentStudioLight
StartupWMClass=Com.forbiddenfantasy.DocumentStudioLight
Terminal=false
Categories=Office;WordProcessor;
MimeType=application/vnd.openxmlformats-officedocument.wordprocessingml.document;text/plain;text/markdown;text/html;application/rtf;
